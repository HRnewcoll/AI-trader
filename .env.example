# Broker credentials (pick one)
OANDA_ACCOUNT_ID=your_oanda_account
OANDA_API_TOKEN=your_oanda_token

MT5_SERVER=your.mt5.server
MT5_LOGIN=12345678
MT5_PASSWORD=your_password

# Notifications (all optional — system still runs without these)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com

# Optional: LLM (system works with local models; these are only needed for cloud)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Reddit API (only needed if using PRAW; system has scrape fallback)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ForexAI/1.0

# Optional: News API (system uses free RSS by default)
NEWS_API_KEY=

# Optional: Twitter/X API (system uses nitter scrape by default)
TWITTER_BEARER_TOKEN=
